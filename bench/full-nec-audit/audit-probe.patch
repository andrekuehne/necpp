diff --git a/src/nec_audit_probe.h b/src/nec_audit_probe.h
new file mode 100644
index 0000000..e871364
--- /dev/null
+++ b/src/nec_audit_probe.h
@@ -0,0 +1,37 @@
+/* Scratch audit probe: compiled in only with -DNECPP_AUDIT_PROBE. Not part of
+   the release build or the public ABI. Prints stage timings and heap use to
+   stderr as "NECPP_PROBE stage=<name> ms=<wall> n=<count> heap=<bytes> used=<bytes>". */
+#pragma once
+#ifdef NECPP_AUDIT_PROBE
+#include <chrono>
+#include <cstdio>
+#include <malloc.h>
+#ifdef __EMSCRIPTEN__
+#include <emscripten/heap.h>
+#endif
+namespace necpp_audit {
+inline double now_ms() {
+  using namespace std::chrono;
+  return duration<double, std::milli>(steady_clock::now().time_since_epoch()).count();
+}
+inline void emit(const char* stage, double ms, long long n) {
+  size_t heap = 0;
+#ifdef __EMSCRIPTEN__
+  heap = emscripten_get_heap_size();
+#endif
+  struct mallinfo mi = mallinfo();
+  std::fprintf(stderr, "NECPP_PROBE stage=%s ms=%.3f n=%lld heap=%zu used=%zu\n",
+    stage, ms, n, heap, static_cast<size_t>(mi.uordblks));
+  std::fflush(stderr);
+}
+}
+#define NECPP_PROBE_START(v) double v = necpp_audit::now_ms()
+#define NECPP_PROBE_END(v, stage, n) necpp_audit::emit(stage, necpp_audit::now_ms() - (v), static_cast<long long>(n))
+#define NECPP_PROBE_ACC(acc, v) (acc) += necpp_audit::now_ms() - (v)
+#define NECPP_PROBE_EMIT(acc, stage, n) necpp_audit::emit(stage, (acc), static_cast<long long>(n))
+#else
+#define NECPP_PROBE_START(v) ((void)0)
+#define NECPP_PROBE_END(v, stage, n) ((void)0)
+#define NECPP_PROBE_ACC(acc, v) ((void)0)
+#define NECPP_PROBE_EMIT(acc, stage, n) ((void)0)
+#endif
